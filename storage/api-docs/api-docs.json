            "post": {
                "tags": [
                    "Nilai"
                ],
                "summary": "Catat nilai mahasiswa setelah semester selesai",
                "description": "Menambahkan data nilai mahasiswa baru. Request wajib Content-Type: application/json. Response mengikuti IAE-T2 Response Wrapper.",
                "operationId": "storeNilai",
                "requestBody": {
                    "description": "Content-Type: application/json",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nim",
                                    "kode_matkul",
                                    "nama_matkul",
                                    "nilai_huruf",
                                    "nilai_angka",
                                    "sks",
                                    "semester",
                                    "tahun_ajaran"
                                ],
                                "properties": {
                                    "nim": {
                                        "type": "string",
                                        "example": "102022400136"
                                    },
                                    "kode_matkul": {
                                        "type": "string",
                                        "example": "SI101"
                                    },
                                    "nama_matkul": {
                                        "type": "string",
                                        "example": "Algoritma dan Pemrograman"
                                    },
                                    "nilai_huruf": {
                                        "description": "Nilai huruf: A, AB, B, BC, C, D, E",
                                        "type": "string",
                                        "example": "A"
                                    },
                                    "nilai_angka": {
                                        "description": "Nilai angka: 4.0, 3.5, 3.0, 2.5, 2.0, 1.0, 0.0",
                                        "type": "number",
                                        "example": 4
                                    },
                                    "sks": {
                                        "type": "integer",
                                        "example": 3
                                    },
                                    "semester": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "tahun_ajaran": {
                                        "type": "string",
                                        "example": "2024/2025"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "IAE-T2 Success Response Wrapper",
                        "headers": {
                            "Content-Type": {
                                "description": "Content-Type: application/json; charset=UTF-8",
                                "schema": {
                                    "type": "string",
                                    "example": "application/json; charset=UTF-8"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/IaeT2SuccessResponse"
                                }
                            }
                        }
                    },
                    "415": {
                        "description": "IAE-T2 Error Response Wrapper — Content-Type bukan application/json",
                        "headers": {
                            "Content-Type": {
                                "description": "Content-Type: application/json; charset=UTF-8",
                                "schema": {
                                    "type": "string",
                                    "example": "application/json; charset=UTF-8"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/IaeT2ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
